import sys
from PyQt6.QtWidgets import (
    QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout,
    QLabel, QPushButton, QLineEdit, QStatusBar, QMessageBox, QCheckBox
)
from PyQt6.QtCore import Qt
from PyQt6.QtGui import QAction


class IndustrialApp(QMainWindow):
    def __init__(self):
        super().__init__()

        # Настройка главного окна
        self.setWindowTitle("Industrial Hello World Application")
        self.resize(550, 480)
        
        # Переменная для отслеживания темы (False - Белая, True - Черная)
        self.is_dark_theme = False

        # Центральный виджет и главный контейнер
        self.central_widget = QWidget()
        self.setCentralWidget(self.central_widget)

        # Создание меню
        self.init_menu()

        # Главный вертикальный лейаут
        layout = QVBoxLayout(self.central_widget)
        layout.setContentsMargins(40, 25, 40, 25)
        layout.setSpacing(15)

        # --- Блок тумблера переключения темы ---
        theme_layout = QHBoxLayout()
        theme_layout.addStretch()  # Прижимаем тумблер к правому краю
        
        # Используем QCheckBox, стилизованный под переключатель (Toggle Switch)
        self.theme_toggle = QCheckBox("Тёмная тема")
        self.theme_toggle.setCursor(Qt.CursorShape.PointingHandCursor)
        self.theme_toggle.toggled.connect(self.toggle_theme)
        theme_layout.addWidget(self.theme_toggle)
        
        layout.addLayout(theme_layout)
        # ----------------------------------------

        # 1. Текстовое поле для вывода приветствия
        self.label = QLabel("Привет, Мир")
        self.label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(self.label)

        # 2. Поле ввода имени
        self.name_input = QLineEdit()
        self.name_input.setPlaceholderText("Введите ваше имя здесь...")
        self.name_input.returnPressed.connect(self.show_greeting)
        layout.addWidget(self.name_input)

        # 3. Синяя кнопка "Показать приветствие"
        self.btn_greet = QPushButton("Показать приветствие")
        self.btn_greet.setCursor(Qt.CursorShape.PointingHandCursor)
        self.btn_greet.clicked.connect(self.show_greeting)
        layout.addWidget(self.btn_greet)

        # Добавляем пустой промежуток снизу
        layout.addStretch()

        # Статусбар снизу окна
        self.status_bar = QStatusBar()
        self.setStatusBar(self.status_bar)
        self.status_bar.showMessage("Приложение готово к работе")

        # Применяем начальные стили (Светлая тема)
        self.apply_theme_styles()

    def init_menu(self):
        """Инициализация верхнего меню приложения."""
        menu_bar = self.menuBar()

        # Меню "Файл"
        file_menu = menu_bar.addMenu("Файл")
        
        clear_action = QAction("Очистить всё", self)
        clear_action.setStatusTip("Сбросить текст и имя")
        clear_action.triggered.connect(self.reset_fields)
        file_menu.addAction(clear_action)
        
        file_menu.addSeparator()
        
        exit_action = QAction("Выход", self)
        exit_action.setStatusTip("Закрыть приложение")
        exit_action.triggered.connect(self.close)
        file_menu.addAction(exit_action)

        # Меню "Помощь"
        help_menu = menu_bar.addMenu("Помощь")
        
        instruction_action = QAction("Инструкция", self)
        instruction_action.triggered.connect(self.show_instruction)
        help_menu.addAction(instruction_action)
        
        about_action = QAction("О программе", self)
        about_action.triggered.connect(self.show_about_dialog)
        help_menu.addAction(about_action)

    def show_greeting(self):
        """Вывод приветствия с введенным именем."""
        name = self.name_input.text().strip()
        if name:
            text = f"Привет, {name}!"
            self.status_bar.showMessage(f"Выведено приветствие для: {name}")
        else:
            text = "Привет, Мир"
            self.status_bar.showMessage("Имя не введено. Выведено стандартное приветствие.")
        
        self.label.setText(text)

    def toggle_theme(self, checked):
        """Слот для переключения флага темы и обновления стилей."""
        self.is_dark_theme = checked
        self.apply_theme_styles()
        theme_name = "Тёмная" if checked else "Светлая"
        self.status_bar.showMessage(f"Включена {theme_name} тема")

    def reset_fields(self):
        """Сброс полей к исходному состоянию (тема при этом сохраняется)."""
        self.name_input.clear()
        self.label.setText("Привет, Мир")
        self.status_bar.showMessage("Поля ввода успешно сброшены")

    def show_instruction(self):
        """Показ инструкции пользователя."""
        QMessageBox.information(
            self,
            "Инструкция",
            "Как пользоваться приложением:\n\n"
            "1. Введите имя в текстовое поле.\n"
            "2. Нажмите кнопку 'Показать приветствие' или клавишу Enter.\n"
            "3. Используйте небольшой тумблер вверху справа для переключения между Белой и Чёрной темой.\n"
            "4. Меню 'Файл' позволяет сбросить текст или закрыть программу."
        )

    def show_about_dialog(self):
        """Показ окна 'О программе'."""
        QMessageBox.about(
            self,
            "О программе",
            "Industrial Hello World Application\n"
            "Версия: 3.0\n"
            "Язык: Python (PyQt6)\n\n"
            "Добавлен тумблер переключения Белой/Чёрной темы."
        )

    def apply_theme_styles(self):
        """Централизованное управление CSS-стилями элементов в зависимости от темы."""
        if self.is_dark_theme:
            # --- ПАЛИТРА ДЛЯ ЧЁРНОЙ ТЕМЫ ---
            bg_window = "#121212"
            bg_label = "#1e1e1e"
            border_label = "#3a3a3a"
            text_main = "#ffffff"
            bg_input = "#2c2c2c"
            border_input = "#444444"
            text_input = "#ffffff"
            bg_menu = "#1e1e1e"
            text_menu = "#ffffff"
        else:
            # --- ПАЛИТРА ДЛЯ БЕЛОЙ ТЕМЫ ---
            bg_window = "#ffffff"
            bg_label = "#f0f4f8"
            border_label = "#6ba4e8"
            text_main = "#2c3e50"
            bg_input = "#ffffff"
            border_input = "#bdc3c7"
            text_input = "#2c3e50"
            bg_menu = "#ffffff"
            text_menu = "#000000"

        # Применение стилей к элементам
        self.central_widget.setStyleSheet(f"background-color: {bg_window};")
        self.menuBar().setStyleSheet(f"background-color: {bg_menu}; color: {text_menu};")
        
        self.theme_toggle.setStyleSheet(f"color: {text_main}; font-size: 14px; font-weight: bold;")
        
        self.label.setStyleSheet(f"""
            QLabel {{
                background-color: {bg_label};
                border: 2px solid {border_label};
                border-radius: 12px;
                color: {text_main};
                font-size: 26px;
                font-weight: bold;
                min-height: 80px;
            }}
        """)
        
        self.name_input.setStyleSheet(f"""
            QLineEdit {{
                border: 2px solid {border_input};
                border-radius: 8px;
                padding: 10px;
                font-size: 16px;
                background-color: {bg_input};
                color: {text_input};
            }}
            QLineEdit:focus {{
                border: 2px solid #2a8ad4;
            }}
        """)
        
        self.btn_greet.setStyleSheet("""
            QPushButton {
                background-color: #2a8ad4;
                color: white;
                border: none;
                border-radius: 8px;
                font-size: 16px;
                font-weight: bold;
                min-height: 50px;
            }
            QPushButton:hover {
                background-color: #2375b3;
            }
            QPushButton:pressed {
                background-color: #1b5b8c;
            }
        """)
        
        self.status_bar.setStyleSheet(f"background-color: {bg_label}; color: {text_main}; font-size: 13px;")


if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = IndustrialApp()
    window.show()
    sys.exit(app.exec())
